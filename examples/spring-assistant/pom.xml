<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.github.acsvhs</groupId><artifactId>ai-contract-test</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../..</relativePath></parent>
  <artifactId>spring-assistant-example</artifactId>
  <name>AI Contract Test Spring Boot Example</name>
  <dependencyManagement>
    <dependencies>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-dependencies</artifactId><version>${spring-boot.version}</version><type>pom</type><scope>import</scope></dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
  </dependencies>
  <properties>
    <example.http.port>18081</example.http.port>
    <example.jmx.port>19001</example.jmx.port>
  </properties>
  <build><plugins>
    <plugin>
      <groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><version>${spring-boot.version}</version>
      <configuration><jmxPort>${example.jmx.port}</jmxPort></configuration>
      <executions>
        <execution>
          <id>start-example</id><phase>pre-integration-test</phase><goals><goal>start</goal></goals>
          <configuration><arguments><argument>--server.port=${example.http.port}</argument></arguments></configuration>
        </execution>
        <execution><id>stop-example</id><phase>post-integration-test</phase><goals><goal>stop</goal></goals></execution>
      </executions>
    </plugin>
    <plugin>
      <groupId>io.github.acsvhs</groupId><artifactId>ai-contract-maven-plugin</artifactId><version>${project.version}</version>
      <executions><execution><id>verify-contracts</id><phase>integration-test</phase><goals><goal>test</goal></goals></execution></executions>
    </plugin>
  </plugins></build>
</project>
