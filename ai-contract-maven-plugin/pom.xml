<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.github.acsvhs</groupId><artifactId>ai-contract-test</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>ai-contract-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>
  <name>AI Contract Test Maven Plugin</name>
  <dependencies>
    <dependency><groupId>io.github.acsvhs</groupId><artifactId>ai-contract-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.github.acsvhs</groupId><artifactId>ai-contract-adapter-http</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.github.acsvhs</groupId><artifactId>ai-contract-adapter-openai-compatible</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.github.acsvhs</groupId><artifactId>ai-contract-recorder</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.apache.maven</groupId><artifactId>maven-plugin-api</artifactId><version>${maven.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.maven.plugin-tools</groupId><artifactId>maven-plugin-annotations</artifactId><version>${maven-plugin-tools.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-nop</artifactId><version>${slf4j.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin>
    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-plugin-plugin</artifactId><version>${maven-plugin-tools.version}</version>
    <configuration><goalPrefix>ai-contract</goalPrefix></configuration>
  </plugin></plugins></build>
</project>
