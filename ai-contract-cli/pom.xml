<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.github.acsvhs</groupId><artifactId>ai-contract-test</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>ai-contract-cli</artifactId>
  <dependencies>
    <dependency><groupId>io.github.acsvhs</groupId><artifactId>ai-contract-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.github.acsvhs</groupId><artifactId>ai-contract-adapter-http</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>info.picocli</groupId><artifactId>picocli</artifactId><version>${picocli.version}</version></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>${slf4j.version}</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin>
    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.1</version>
    <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
      <createDependencyReducedPom>false</createDependencyReducedPom>
      <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>io.github.acsvhs.aicontract.cli.AiContractCli</mainClass></transformer></transformers>
    </configuration></execution></executions>
  </plugin></plugins></build>
</project>
