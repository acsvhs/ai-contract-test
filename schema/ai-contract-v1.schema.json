{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/acsvhs/ai-contract-test/schema/ai-contract-v1.schema.json",
  "title": "AI Contract Test contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "suite", "target", "cases"],
  "properties": {
    "version": { "const": "1" },
    "suite": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "defaultTimeoutMs": { "type": "integer", "minimum": 1 },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "variables": { "type": "object", "additionalProperties": { "type": "string" } },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["type", "baseUrl"],
      "properties": {
        "type": { "enum": ["http", "openai-compatible", "openai", "anthropic", "gemini"] }, "baseUrl": { "type": "string", "minLength": 1 },
        "headers": { "$ref": "#/$defs/stringMap" },
        "maxResponseBytes": { "type": "integer", "minimum": 1, "maximum": 104857600 }
      }
    },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "request", "assertions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "repeat": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "minimumPassRate": { "type": "number", "minimum": 0, "maximum": 1 },
          "dataset": { "type": "string", "minLength": 1 },
          "request": {
            "type": "object", "additionalProperties": false, "required": ["path"],
            "properties": {
              "method": { "type": "string", "pattern": "^[A-Za-z]+$" }, "path": { "type": "string", "pattern": "^/[^?#]*$" },
              "headers": { "$ref": "#/$defs/stringMap" }, "query": { "$ref": "#/$defs/stringMap" }, "body": {}
            }
          },
          "assertions": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["type"],
              "properties": {
                "type": { "enum": ["httpStatus", "contains", "regexAbsent", "maxLatency", "jsonSchema", "jsonPath", "allowedToolCalls", "forbiddenToolCalls", "toolCalled", "toolNotCalled", "toolArgs", "toolCallOrder", "maxToolCalls", "maxTokens", "maxEstimatedCost", "secretLeak", "piiLeak", "semanticSimilarity", "llmJudge"] },
                "equals": {},
                "oneOf": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 100, "maximum": 599 }, "uniqueItems": true },
                "value": { "type": "string" },
                "name": { "type": "string", "minLength": 1 },
                "expected": { "type": "string" },
                "minimum": { "type": "number", "minimum": 0, "maximum": 1 },
                "endpoint": { "type": "string", "minLength": 1 },
                "model": { "type": "string", "minLength": 1 },
                "headers": { "$ref": "#/$defs/stringMap" },
                "responsePath": { "type": "string", "minLength": 1 },
                "timeoutMs": { "type": "integer", "minimum": 1 },
                "patterns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "milliseconds": { "type": "integer", "minimum": 0 },
                "file": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "exists": { "type": "boolean" },
                "names": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                "maximum": { "type": "number", "minimum": 0 },
                "inputCostPerMillionTokens": { "type": "number", "minimum": 0 },
                "outputCostPerMillionTokens": { "type": "number", "minimum": 0 },
                "currency": { "type": "string", "minLength": 1 }
              },
              "allOf": [
                { "if": { "properties": { "type": { "const": "toolCalled" } } }, "then": { "required": ["name"] } },
                { "if": { "properties": { "type": { "const": "toolNotCalled" } } }, "then": { "required": ["name"] } },
                { "if": { "properties": { "type": { "const": "toolArgs" } } }, "then": { "required": ["name", "path", "equals"] } },
                { "if": { "properties": { "type": { "const": "toolCallOrder" } } }, "then": { "required": ["names"], "properties": { "names": { "minItems": 1 } } } },
                { "if": { "properties": { "type": { "enum": ["maxToolCalls", "maxTokens"] } } }, "then": { "required": ["maximum"], "properties": { "maximum": { "type": "integer" } } } },
                { "if": { "properties": { "type": { "enum": ["semanticSimilarity", "llmJudge"] } } }, "then": { "required": ["expected", "minimum", "endpoint", "model"] } }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": { "stringMap": { "type": "object", "additionalProperties": { "type": "string" } } }
}
